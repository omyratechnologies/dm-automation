  scopes                String[] @default([])
  status                API_KEY_STATUS @default(ACTIVE)
  createdByMembershipId String @db.Uuid
  createdByMembership   Membership @relation(fields: [createdByMembershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  lastUsedAt            DateTime?
  expiresAt             DateTime?
  revokedAt             DateTime?
  createdAt             DateTime @default(now())

  @@unique([workspaceId, keyPrefix])
  @@index([workspaceId, status])
}
