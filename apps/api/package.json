{
  "name": "@repo/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --no-watchman",
    "docs:generate": "npm run build --workspace @repo/shared && nest build && node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.4",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "@prisma/client": "^6.18.0",
    "@repo/shared": "*",
    "@scalar/api-reference": "^1.67.0",
    "@scalar/nestjs-api-reference": "^1.2.17",
    "axios": "^1.7.9",
    "bullmq": "^5.34.8",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "luxon": "^3.7.2",
    "nestjs-pino": "^4.1.0",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@asyncapi/diff": "^0.5.0",
    "@asyncapi/parser": "^3.6.3",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20",
    "browserslist": "^4.28.8",
    "fast-uri": "^3.1.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
